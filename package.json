{
  "name": "agents-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Static website hosting four autonomous data agents: real estate, macro/Fed, federal grants & contracts, and repo maintenance.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch-data": "node scripts/fetch-data.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "gen:fixtures": "python3 scripts/gen_fixtures.py",
    "prebuild": "node scripts/ensure-data.mjs && node scripts/gen-sitemap.mjs && node scripts/gen-og.mjs",
    "dev": "node scripts/ensure-data.mjs && next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "e2e": "playwright test",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "diff": "^8.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.56.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^16.0.0",
    "json-schema-to-zod": "^2.8.1",
    "playwright": "1.56.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "satori": "^0.33.5",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
